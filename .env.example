# Copy to .env if you want to change any of these. Every one has a default that
# works, so an empty file — or no file at all — is a valid configuration.
#
# Each of these also works as a one-off on the command line, e.g.
#   LOG_FORMAT=json docker compose up -d
#
# Adding a setting here means adding it to the environment: block in
# docker-compose.yml too. Compose reads this file to fill in ${...}, not to hand
# the container an environment, so a variable named only here reaches nobody —
# which looks exactly like setting it and having no effect.

# Where people reach this instance. Decides whether session cookies carry the
# Secure attribute, so it has to match how the browser actually connects.
# Behind a TLS-terminating proxy, set the https URL and TRUST_PROXY=true.
#PUBLIC_URL=https://llm.example.com
#TRUST_PROXY=true
#TRUST_PROXY_HOPS=1

# Host port to publish. Change it if 8080 is taken.
#PORT=8080

# Create the first administrator without opening a browser. Leave both unset to
# use the setup page instead; setting only one is a startup error.
#FAIRLB_ADMIN_EMAIL=you@example.com
#FAIRLB_ADMIN_PASSWORD=a-long-password-you-will-remember

# Require a token to complete setup. Worth setting if the instance is reachable
# from the internet before you have finished installing it; on a laptop or a
# private network it is friction with nothing on the other side of it.
#FAIRLB_SETUP_TOKEN=

# The master key encrypting provider credentials at rest. Unset means "generate
# one and keep it in the data volume", which is what you want for a single
# instance. Set it explicitly when running more than one replica, since they do
# not share a volume: openssl rand -hex 32
#SECRET_KEY=

# text is readable in a terminal and includes debug lines; json is what a log
# collector wants.
#LOG_FORMAT=text

# Report which upstream a request was routed to, on the response. Useful while
# setting providers up, off by default because it describes internals.
#FAIRLB_PROBE_TRACE=true

# How stopping is paced. First /healthz turns 503 for DRAIN_GRACE_SECONDS while
# the gateway keeps serving, so whatever is in front stops sending; then
# requests already running get SHUTDOWN_TIMEOUT_SECONDS to finish. Raise the
# second one above your longest request — image generation runs for minutes —
# and raise stop_grace_period in docker-compose.yml along with it, or Compose
# kills the container first.
#DRAIN_GRACE_SECONDS=0
#SHUTDOWN_TIMEOUT_SECONDS=320

# Redis makes rate limits and circuit-breaker state shared across replicas. A
# single instance does not need it.
#REDIS_URL=redis://redis:6379
#DRIVER_CACHE=redis
#DRIVER_RATELIMIT=redis
#DRIVER_BREAKER=redis
#DRIVER_LOCK=redis

# Optional capacity and abuse-control overrides. Unset pool size delegates to
# pgx; the request limits default to 300 RPM generally and 10 RPM for auth.
#DB_POOL_MAX_CONNS=10
#RATE_LIMIT_PER_IP_RPM=300
#AUTH_RATE_LIMIT_PER_IP_RPM=10
#RATE_LIMIT_DISABLED=false

# Run this instance under your own name and colours. Build a brand bundle from
# a profile, mount it, and name the path it has *inside* the container:
#
#   node web/scripts/pack-brand-profile.mjs /path/to/profile.json ./brand
#
# then uncomment the matching volume line in docker-compose.yml. Unset serves
# the brand built into the image; a path with no readable bundle behind it
# stops the container rather than quietly serving the built-in one.
#BRAND_PROFILE_DIR=/etc/fairlb/brand
